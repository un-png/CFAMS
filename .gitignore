# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# CFAMS local artifacts and credentials
**/target/
**/node_modules/
**/dist/
**/.idea/
**/logs/
**/uploads/
**/*.log
**/.env.local
**/.env.*.local
**/application-local.yml

# CFAMS rules (scoped to preserve previous behavior)
/CFAMS/**/.gradle
/CFAMS/build/
!/CFAMS/gradle/wrapper/gradle-wrapper.jar
!/CFAMS/.mvn/wrapper/maven-wrapper.jar
/CFAMS/**/.apt_generated
/CFAMS/**/.classpath
/CFAMS/**/.factorypath
/CFAMS/**/.project
/CFAMS/**/.settings
/CFAMS/**/.springBeans
/CFAMS/**/.idea
/CFAMS/**/*.iws
/CFAMS/**/*.iml
/CFAMS/**/*.ipr
/CFAMS/**/*.yml
/CFAMS/**/rebel.xml
/CFAMS/nbproject/private/
/CFAMS/build/*
/CFAMS/**/nbbuild/
/CFAMS/**/nbdist/
/CFAMS/**/.nb-gradle/
/CFAMS/**/*.xml.versionsBackup
/CFAMS/**/*.swp
!/CFAMS/*/build/*.java
!/CFAMS/*/build/*.html
!/CFAMS/*/build/*.xml

# CFAMS-web rules (scoped to preserve previous behavior)
/CFAMS-web/**/.DS_Store
/CFAMS-web/**/npm-debug.log*
/CFAMS-web/**/yarn-debug.log*
/CFAMS-web/**/yarn-error.log*
/CFAMS-web/tests/**/coverage/
/CFAMS-web/tests/e2e/reports
/CFAMS-web/**/selenium-debug.log
/CFAMS-web/**/.idea
/CFAMS-web/**/.vscode
/CFAMS-web/**/*.suo
/CFAMS-web/**/*.ntvs*
/CFAMS-web/**/*.njsproj
/CFAMS-web/**/*.sln
/CFAMS-web/**/*.local
/CFAMS-web/**/package-lock.json
/CFAMS-web/**/yarn.lock
/CFAMS-web/CFAMS/
/CFAMS-web/CFAMS-app/
/CFAMS-web/cfams-app/
/CFAMS-web/app/
